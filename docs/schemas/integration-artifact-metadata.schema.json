{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/integration-artifact-metadata.schema.json",
  "title": "IntegrationArtifactMetadata",
  "type": "object",
  "required": [
    "artifact_id",
    "config_entry_id",
    "job_id",
    "source_snapshot_id",
    "artifact_kind",
    "status",
    "title",
    "image_url",
    "time_range",
    "series",
    "overlays",
    "render_metadata",
    "validation",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "config_entry_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "job_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "artifact_kind": {
      "const": "chart_image"
    },
    "status": {
      "enum": [
        "placeholder",
        "rendered"
      ]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "image_url": {
      "type": "string",
      "pattern": "\\S"
    },
    "time_range": {
      "type": "string",
      "pattern": "\\S"
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chartItem"
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chartItem"
      }
    },
    "summary": {
      "type": "string",
      "description": "Model-authored chart caption (ADR-0027 D3). Optional; threaded into the complete snapshot's chart.summary."
    },
    "answer_text": {
      "type": "string",
      "description": "Grounded model-authored analysis answer (ADR-0031 tranche 1). Optional; threaded from render_metadata.answer_text into the complete snapshot's chart.answer_text. Absent for chart-only renders and the Pillow fallback."
    },
    "legend": {
      "type": "array",
      "description": "Renderer color manifest (ADR-0027 D1). Optional; threaded into the complete snapshot's chart.legend.",
      "items": {
        "$ref": "#/$defs/legendItem"
      }
    },
    "render_path": {
      "enum": ["codegen", "pillow"],
      "description": "How the chart was rendered (ADR-0030). Optional; threaded into the complete snapshot's chart.render_path."
    },
    "render_fallback_reason": {
      "type": "string",
      "description": "Present when the Pillow render happened because codegen could not complete (ADR-0030: fallback surfaced, never silent). Carries the final codegen or transport failure code."
    },
    "answer_verification": {
      "enum": ["verified", "unverified"],
      "description": "Grounding check result (ADR-0031 D8a). 'verified': value independently reproduced from allowlisted data and verdict follows the declared rule; 'unverified': internal consistency only or the metric is outside the registry. Absent when no grounding check ran (chart-only, Pillow path)."
    },
    "render_metadata": {
      "type": "object",
      "required": [
        "renderer",
        "render_attempted",
        "worker_called",
        "chart_rendering_called"
      ],
      "additionalProperties": false,
      "properties": {
        "renderer": {
          "enum": [
            "artifact_storage_scaffold",
            "in_process_pillow",
            "worker_renderer"
          ]
        },
        "render_attempted": {
          "type": "boolean"
        },
        "worker_called": {
          "type": "boolean"
        },
        "chart_rendering_called": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "summary",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "pass"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "status": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "chartItem": {
      "type": "object",
      "required": [
        "label",
        "entity_id"
      ],
      "additionalProperties": false,
      "properties": {
        "series_id": {
          "type": "string"
        },
        "overlay_id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "entity_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "legendItem": {
      "type": "object",
      "required": [
        "label",
        "entity_id",
        "color",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "kind": {
          "enum": [
            "series",
            "overlay"
          ]
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "color"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    }
  }
}
